{
  "$schema": "https://app.kilo.ai/config.json",
  // FWAI harness config for Kilo Code. It ships in the FWAI starter folder
  // (public/hk/fwai-starter.zip): Kilo reads it, with AGENTS.md, from the
  // folder you open in VS Code. It also works as ~/.config/kilo/kilo.jsonc.
  // No n8n server here on purpose: "Build your first automation" adds it to
  // ~/.config/kilo/kilo.jsonc with your own token, and an entry here would
  // override that one.
  // No key lives in this file: paste your DeepSeek key once in Kilo Code
  // (Kilo 7.6.2: the gear -> "Providers" -> "Connect" next to DeepSeek). Kilo
  // stores it in its own auth store.
  //
  // Model: DeepSeek V4.1 Flash. Verified 11 Sep 2026 by a direct API call:
  // /models lists only deepseek-flash and deepseek-v4-pro, and v4-pro retires
  // into Flash on 14 Sep 2026, so it is not an upgrade path.
  "model": "deepseek/deepseek-flash",
  "provider": {
    "deepseek": {
      "options": { "baseURL": "https://api.deepseek.com/v1" },
      "models": {
        "deepseek-flash": { "name": "DeepSeek V4.1 Flash", "tool_call": true, "limit": { "context": 1000000, "output": 32000 } }
      }
    }
  },
  "mcp": {
    // Lets the agent drive your own logged-in Chrome. Powerful, and it can
    // act as you on any site you are signed into, so it is OFF for members
    // by default. Turn it on only for a task that needs a browser, then off.
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": false,
      "timeout": 30000
    }
  }
}
